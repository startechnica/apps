## modules/eap -- EAP module (rlm_eap), EAP-TLS + EAP-TTLS methods
##
eap {
	default_eap_type = {{ .Values.modules.eap.defaultType }}

	timer_expire = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no
	max_sessions = ${max_requests}

	tls-config {{ .Values.modules.eap.tlsConfig.name }} {
		certificate_file = {{ include "freeradius.eap.tlsConfig.certPath" . }}
		private_key_file = {{ include "freeradius.eap.tlsConfig.certKeyPath" . }}
		private_key_password = $ENV{FREERADIUS_MODS_EAP_TLS_PRIVKEY_PASSWORD}
		ca_file = {{ include "freeradius.eap.tlsConfig.caCertPath" . }}
		random_file = {{ .Values.modules.eap.tlsConfig.random_file }}

		cipher_list = "{{ .Values.modules.eap.tlsConfig.cipher_list }}"
		cipher_server_preference = {{ ternary "yes" "no" .Values.modules.eap.tlsConfig.cipher_server_preference }}
		tls_min_version = "{{ .Values.modules.eap.tlsConfig.min_version }}"
		tls_max_version = "{{ .Values.modules.eap.tlsConfig.max_version }}"

		cache {
			{{- include "freeradius.tplvalues.renderConfig" (dict "value" .Values.modules.eap.tlsConfig.cache "context" $) | nindent 12 }}
		}

		verify {
			{{- include "freeradius.tplvalues.renderConfig" (dict "value" .Values.modules.eap.tlsConfig.verify "context" $) | nindent 12 }}
		}

		ocsp {
			{{- include "freeradius.tplvalues.renderConfig" (dict "value" .Values.modules.eap.tlsConfig.ocsp "context" $) | nindent 12 }}
		}
	}

	#  EAP methods, rendered from `modules.eap.methods`. Each method's config map
	#  (`modules.eap.<method>`) becomes its block body via renderConfig; methods
	#  with no config map render an empty `<method> {}`.
	{{- range $method := .Values.modules.eap.methods }}
	{{ $method }} {
		{{- with index $.Values.modules.eap $method }}
		{{- include "freeradius.tplvalues.renderConfig" (dict "value" . "context" $) | nindent 8 }}
		{{- end }}
	}
	{{- end }}
}
