# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store

# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.claude/
.hg/
.hgignore
.svn/
.vscode/

# Common backup files
*.swp
*.bak
*.tmp
*~

# Various IDEs
.project
.idea/
*.tmproj

# OWNERS file for Kubernetes
OWNERS

# Helm dependency build artifacts (downloaded subcharts + lock)
charts/*/charts/
charts/*/Chart.lock
