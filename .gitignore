# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store

# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.claude/
.debug/
.hg/
.hgignore
.svn/
.vscode/

# Common backup files
*.swp
*.bak
*.tmp
*~

# Various IDEs
.project
.idea/
*.tmproj

# OWNERS file for Kubernetes
OWNERS

# Helm dependency build artifacts (downloaded subcharts).
# Chart.lock IS committed so ArgoCD's `helm dependency build` pulls pinned
# OCI tags instead of range-resolving via Docker Hub's (deprecated) tags/list.
charts/**/charts/
